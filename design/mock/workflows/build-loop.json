{
  "version": 1,
  "name": "Build loop",
  "settings": {
    "tests": true,
    "agentReview": true,
    "fullReviewRounds": 3,
    "approvalAfterRound": 4,
    "maxReviewRounds": null,
    "stuckPoints": 12,
    "stuckShare": 30,
    "stuckRounds": 3,
    "autoMergeFix": true
  },
  "phases": [
    {
      "id": "phase-1",
      "name": "Define",
      "blocks": [
        {
          "id": "phase-1-state-1",
