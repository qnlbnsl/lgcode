          "role": "project-lead",
          "steps": []
        },
        {
          "id": "phase-1-state-4",
          "name": "Change described",
          "role": "owner",
          "steps": []
        },
        {
          "id": "phase-1-state-5",
          "name": "Mockups made if screens change",
          "role": "project-lead",
          "steps": []
        },
        {
          "id": "phase-1-state-6",
          "name": "End-result page written",
          "role": "project-lead",
