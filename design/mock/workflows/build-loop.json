          "steps": []
        },
        {
          "id": "phase-1-state-9",
          "name": "Project read",
          "role": "project-lead",
          "steps": []
        },
        {
          "id": "phase-1-state-10",
          "name": "Project explained",
          "role": "owner",
          "steps": []
        },
        {
          "id": "phase-1-state-11",
          "name": "Direction set",
          "role": "owner",
          "steps": []
        },
        {
          "id": "phase-1-state-12",
          "name": "Want tests?",
          "role": "owner",
          "steps": []
        },
        {
          "id": "phase-1-state-13",
          "name": "Test commands ready",
          "role": "engine",
          "steps": []
        },
        {
          "id": "phase-1-state-14",
          "name": "Config file written",
          "role": "project-lead",
          "steps": []
        },
        {
          "id": "phase-1-state-15",
          "name": "Agent review?",
          "role": "project-lead",
          "steps": []
        },
        {
          "id": "phase-1-state-16",
          "name": "Tests wanted later",
          "role": "owner",
          "steps": []
        }
      ]
    },
    {
      "id": "phase-2",
      "name": "Design and teams",
      "blocks": [
        {
          "id": "phase-2-state-1",
          "name": "Change approved",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-2",
          "name": "Tests on?",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-3",
          "name": "Valid checkpoint?",
          "role": "engine",
          "steps": []
        },
        {
          "id": "phase-2-state-4",
          "name": "Code read",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-5",
          "name": "Full run passes?",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-6",
          "name": "Fix sprint added",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-7",
          "name": "Findings reconciled",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-8",
          "name": "Split by domain",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-9",
          "name": "Sized in points",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-10",
          "name": "Teams decided",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-11",
          "name": "User-flow tests written",
          "role": "orchestrator",
          "steps": []
        },
        {
          "id": "phase-2-state-12",
          "name": "Teams started",
          "role": "engine",
          "steps": []
        }
      ]
    },
    {
      "id": "phase-3",
      "name": "Plan",
      "blocks": [
        {
          "id": "phase-3-state-4",
          "name": "Teams started",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-5",
          "name": "Plan read",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-6",
          "name": "Subitems split",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-7",
          "name": "Plan written",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-8",
          "name": "Question sets picked",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-9",
          "name": "Plan reviewed",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-10",
          "name": "Blocker?",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-11",
          "name": "Report clean?",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-12",
          "name": "Plans compared",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-state-13",
          "name": "Plans work together?",
          "role": "planning-lead",
          "steps": []
        },
        {
          "id": "phase-3-block-1",
          "name": "Write each plan",
          "role": "planner",
          "steps": [
            {
              "from": "Subitems split",
              "to": "Code read",
              "when": "Read the code",
              "role": "planning-lead"
            },
            {
              "from": "Code read",
              "to": "Question answered",
              "when": "Answer next, with citations [OWNER IF NEEDED]",
              "role": "planning-lead"
            },
            {
              "from": "Question answered",
              "to": "Answered enough?",
              "when": "Judge own answer",
              "role": "planning-lead"
            },
            {
              "from": "Answered enough?",
              "to": "All answered?",
              "when": "yes",
              "role": "planning-lead"
            },
            {
              "from": "All answered?",
              "to": "Citations real?",
              "when": "yes: script checks",
              "role": "engine"
            },
            {
              "from": "Citations real?",
              "to": "Plan written",
              "when": "yes",
              "role": "planning-lead"
            },
            {
              "from": "Answered enough?",
              "to": "Code read",
              "when": "no: read more",
              "role": "planning-lead"
            },
            {
              "from": "All answered?",
              "to": "Code read",
              "when": "no: next question",
              "role": "planning-lead"
            },
            {
              "from": "Citations real?",
              "to": "Code read",
              "when": "no: fix the citation",
              "role": "planning-lead"
            }
          ]
        },
        {
          "id": "phase-3-block-2",
          "name": "Review each plan",
          "role": "reviewer",
          "steps": [
            {
              "from": "Sets picked",
              "to": "Question answered",
              "when": "Answer next question",
              "role": "planning-lead"
            },
            {
              "from": "Question answered",
              "to": "Blocker?",
              "when": "Continue",
              "role": "planning-lead"
            },
            {
              "from": "Blocker?",
              "to": "Answer logged",
              "when": "no: log any problem",
              "role": "planning-lead"
            },
            {
              "from": "Answer logged",
              "to": "All answered?",
              "when": "Continue",
              "role": "planning-lead"
            },
            {
              "from": "All answered?",
              "to": "Statement stuck?",
              "when": "yes: script scores",
              "role": "engine"
            },
            {
              "from": "Statement stuck?",
              "to": "Statement settled",
              "when": "yes: ping the owner; keep, change or drop it [OWNER]",
              "role": "owner"
            },
            {
              "from": "Statement settled",
              "to": "Plan reviewed",
              "when": "Write it in the plan",
              "role": "planning-lead"
            },
            {
              "from": "Blocker?",
              "to": "Blocker raised",
              "when": "yes",
              "role": "planning-lead"
            },
            {
              "from": "Statement stuck?",
              "to": "Plan reviewed",
              "when": "no",
              "role": "planning-lead"
            },
            {
              "from": "All answered?",
              "to": "Question answered",
              "when": "no: next question",
              "role": "planning-lead"
            }
          ]
        },
        {
          "id": "phase-3-block-3",
          "name": "Next round",
          "role": "reviewer",
          "steps": [
            {
              "from": "Scope changed",
              "to": "Full review",
              "when": "the owner changes it: count restarts [OWNER]",
              "role": "owner"
            },
            {
              "from": "Report not clean",
              "to": "All folded",
              "when": "Fold everything",
              "role": "planning-lead"
            },
            {
              "from": "All folded",
              "to": "Round 3 done?",
              "when": "Script counts",
              "role": "engine"
            },
            {
              "from": "Round 3 done?",
              "to": "Full review",
              "when": "no",
              "role": "planning-lead"
            },
            {
              "from": "Round 3 done?",
              "to": "Round 4 done?",
              "when": "yes",
              "role": "planning-lead"
            },
            {
              "from": "Round 4 done?",
              "to": "Blockers, majors review",
              "when": "no",
              "role": "planning-lead"
            },
            {
              "from": "Round 4 done?",
              "to": "Round 6 done?",
              "when": "yes",
              "role": "planning-lead"
            },
            {
              "from": "Round 6 done?",
              "to": "Approve next round?",
              "when": "no: ping the owner, says why [OWNER]",
              "role": "owner"
            },
            {
              "from": "Approve next round?",
              "to": "Blockers, majors review",
              "when": "yes [OWNER]",
              "role": "owner"
            },
            {
              "from": "Approve next round?",
              "to": "Plan cut, split or accepted",
              "when": "no [OWNER]",
              "role": "owner"
            },
            {
              "from": "Plan cut, split or accepted",
              "to": "Plans compared",
              "when": "Continue",
              "role": "planning-lead"
            },
            {
              "from": "Round 6 done?",
              "to": "Approve next round?",
              "when": "yes: ask the owner before every further round, with no hard limit [OWNER]",
              "role": "owner"
            }
          ]
        }
      ]
    },
    {
      "id": "phase-4",
      "name": "Build",
      "blocks": [
        {
          "id": "phase-4-state-4",
          "name": "Plans agreed",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-5",
          "name": "Tests on?",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-6",
          "name": "All teams merged",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-7",
          "name": "Plans read",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-8",
          "name": "Subitems assigned",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-9",
          "name": "Configs built",
          "role": "engine",
          "steps": []
        },
        {
          "id": "phase-4-state-10",
          "name": "Subitems building",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-11",
          "name": "Subitems built",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-12",
          "name": "Passing report?",
          "role": "engine",
          "steps": []
        },
        {
          "id": "phase-4-state-13",
          "name": "Temp merge made",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-14",
          "name": "All pass?",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-15",
          "name": "Subitems merged",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-state-16",
          "name": "More subitems?",
          "role": "build-lead",
          "steps": []
        },
        {
          "id": "phase-4-block-1",
          "name": "Build subitems",
          "role": "builder",
          "steps": [
            {
              "from": "Building",
              "to": "Tests and stubs written",
              "when": "Write stubs, tests: unit, integration, behavior",
              "role": "build-lead"
            },
            {
              "from": "Tests and stubs written",
              "to": "Fail on the assertion?",
              "when": "Script runs them",
              "role": "engine"
            },
            {
              "from": "Fail on the assertion?",
              "to": "Tests match the page?",
              "when": "yes: check tests against page",
              "role": "build-lead"
            },
            {
              "from": "Tests match the page?",
              "to": "Tests approved",
              "when": "yes",
              "role": "build-lead"
            },
            {
              "from": "Tests approved",
              "to": "Code written",
              "when": "Write code, edit old work, narrow runs [OWNER IF NEEDED]",
              "role": "build-lead"
            },
            {
              "from": "Code written",
              "to": "Code committed",
              "when": "Commit; tell build lead: done",
              "role": "build-lead"
            },
            {
              "from": "Code committed",
              "to": "Checks pass?",
              "when": "Build lead calls lgtm check; test runner runs builder's config",
              "role": "build-lead"
            },
            {
              "from": "Checks pass?",
              "to": "Risky tests?",
              "when": "yes: script finds risky labels",
              "role": "engine"
            },
            {
              "from": "Risky tests?",
              "to": "Code broken on temp",
              "when": "yes: break it on a temp branch",
              "role": "build-lead"
            },
            {
              "from": "Code broken on temp",
              "to": "Tests go red?",
              "when": "Script runs risky tests",
              "role": "engine"
            },
            {
              "from": "Tests go red?",
              "to": "Subitem built",
              "when": "yes",
              "role": "build-lead"
            },
            {
              "from": "Checks pass?",
              "to": "Type of failure?",
              "when": "no: report to builder, notice to lead",
              "role": "build-lead"
            },
            {
              "from": "Type of failure?",
              "to": "3 Plan",
              "when": "plan: tell lead",
              "role": "build-lead"
            },
            {
              "from": "Fail on the assertion?",
              "to": "Building",
              "when": "no: fix the test",
              "role": "build-lead"
            },
            {
              "from": "Tests match the page?",
              "to": "Building",
              "when": "no: rewrite",
              "role": "build-lead"
            },
            {
              "from": "Tests go red?",
              "to": "Building",
              "when": "no: tests too weak",
              "role": "build-lead"
            },
            {
              "from": "Risky tests?",
              "to": "Subitem built",
              "when": "no",
              "role": "build-lead"
            },
            {
              "from": "Type of failure?",
              "to": "Building",
              "when": "test: tell lead",
              "role": "build-lead"
            },
            {
              "from": "Type of failure?",
              "to": "Tests approved",
              "when": "code: tell lead",
              "role": "build-lead"
            }
          ]
        },
        {
          "id": "phase-4-block-2",
          "name": "Build without tests",
          "role": "builder",
          "steps": [
            {
              "from": "Tests off",
              "to": "Plans read",
              "when": "Read the plans",
              "role": "build-lead"
            },
            {
              "from": "Plans read",
              "to": "Subitems assigned",
              "when": "Assign up to its cap",
              "role": "build-lead"
            },
            {
              "from": "Subitems assigned",
              "to": "Code written",
              "when": "Write code",
              "role": "build-lead"
            },
            {
              "from": "Code written",
              "to": "Agent review on?",
              "when": "Continue",
              "role": "build-lead"
            },
            {
              "from": "Agent review on?",
              "to": "Subitems merged",
              "when": "no: merge, fix conflicts",
              "role": "build-lead"
            },
            {
              "from": "Agent review on?",
              "to": "Looks good?",
              "when": "yes: review the code",
              "role": "build-lead"
            },
            {
              "from": "Subitems merged",
              "to": "More subitems?",
              "when": "Continue",
              "role": "build-lead"
            },
            {
              "from": "More subitems?",
              "to": "All teams merged",
              "when": "no: orchestrator merges teams",
              "role": "build-lead"
            },
            {
              "from": "Looks good?",
              "to": "Subitems merged",
              "when": "yes: merge",
              "role": "build-lead"
            },
            {
              "from": "Looks good?",
              "to": "Code written",
              "when": "no: fix",
              "role": "build-lead"
            },
            {
              "from": "More subitems?",
              "to": "Subitems assigned",
              "when": "yes: assign next",
              "role": "build-lead"
            }
          ]
        },
        {
          "id": "phase-4-block-3",
          "name": "Fix team",
          "role": "build-lead",
          "steps": [
            {
              "from": "Failure report",
              "to": "Report read",
              "when": "Read the report",
              "role": "build-lead"
            },
            {
              "from": "Report read",
              "to": "Fix team started",
              "when": "Set up a fix team",
              "role": "build-lead"
            },
            {
              "from": "Fix team started",
              "to": "Fixes built",
              "when": "Build subitems",
              "role": "build-lead"
            },
            {
              "from": "Fixes built",
              "to": "Passing report?",
              "when": "LGTM Studio merge: looks up commit",
              "role": "engine"
            },
            {
              "from": "Passing report?",
              "to": "5 Verify",
              "when": "yes: merge",
              "role": "build-lead"
            },
            {
              "from": "Passing report?",
              "to": "Fix team started",
              "when": "no: run the check",
              "role": "build-lead"
            }
          ]
        }
      ]
    },
    {
      "id": "phase-5",
      "name": "Verify",
      "blocks": [
        {
          "id": "phase-5-state-1",
          "name": "Teams merged",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-2",
          "name": "Tests on?",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-3",
          "name": "Install smoke-tested",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-4",
          "name": "Full suite run",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-5",
          "name": "User flows run",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-6",
          "name": "Evidence checked",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-7",
          "name": "All pass?",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-8",
          "name": "Agent review on?",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-9",
          "name": "Product checked",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-10",
          "name": "Looks good?",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-11",
          "name": "Failure report written",
          "role": "test-runner",
          "steps": []
        },
        {
          "id": "phase-5-state-12",
          "name": "Fixes merged",
          "role": "engine",
          "steps": []
        },
        {
          "id": "phase-5-state-13",
          "name": "Failed, related tests run",
          "role": "engine",
          "steps": []
        }
      ]
    },
    {
      "id": "phase-6",
      "name": "Review",
      "blocks": [
        {
          "id": "phase-6-state-1",
          "name": "Verified",
          "role": "reviewer",
          "steps": []
        },
        {
          "id": "phase-6-state-2",
          "name": "Changes listed",
          "role": "reviewer",
          "steps": []
        },
        {
          "id": "phase-6-state-3",
          "name": "Slices reviewed",
          "role": "reviewer",
          "steps": []
        },
        {
          "id": "phase-6-state-4",
          "name": "Findings verified",
          "role": "reviewer",
          "steps": []
        },
        {
          "id": "phase-6-state-5",
          "name": "Severity settled",
          "role": "reviewer",
          "steps": []
        },
        {
          "id": "phase-6-state-6",
          "name": "Findings sorted",
          "role": "reviewer",
          "steps": []
        },
        {
          "id": "phase-6-state-7",
          "name": "Statement stuck?",
          "role": "engine",
          "steps": []
        },
        {
          "id": "phase-6-state-8",
          "name": "All closed?",
          "role": "reviewer",
          "steps": []
        },
        {
          "id": "phase-6-state-9",
          "name": "Statement settled",
          "role": "owner",
          "steps": []
        }
      ]
    },
    {
      "id": "phase-7",
      "name": "Hand over",
      "blocks": [
        {
          "id": "phase-7-state-1",
          "name": "Review closed",
          "role": "project-lead",
          "steps": []
        },
        {
          "id": "phase-7-state-2",
          "name": "Work merged",
          "role": "project-lead",
          "steps": []
        },
        {
          "id": "phase-7-state-3",
