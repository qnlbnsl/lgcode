#!/bin/sh
set -eu

# Herdr may start without a shell profile or a PATH containing Node.js.
install_hint() {
  echo 'LGcode needs Node.js 26. Run nvm install 26, or set LGCODE_NODE to its executable.' >&2
  exit 1
}

node_bin=${LGCODE_NODE:-}
if [ -z "$node_bin" ]; then
  nvm_directory=${NVM_DIR:-${HOME:-}/.nvm}
  newest_minor=-1
  newest_patch=-1
  for candidate in "$nvm_directory"/versions/node/v26.*/bin/node; do
    [ -x "$candidate" ] || continue
    version=${candidate%/bin/node}
    version=${version##*/v26.}
    minor=${version%%.*}
    patch=${version#*.}
    case "$minor" in ''|*[!0-9]*) continue ;; esac
    case "$patch" in ''|*[!0-9]*) continue ;; esac
    if [ "$minor" -gt "$newest_minor" ] ||
       { [ "$minor" -eq "$newest_minor" ] && [ "$patch" -gt "$newest_patch" ]; }; then
      node_bin=$candidate
      newest_minor=$minor
      newest_patch=$patch
    fi
  done
fi

if [ -z "$node_bin" ]; then
  node_bin=$(command -v node) || install_hint
  case "$("$node_bin" --version 2>/dev/null)" in
    v26.*) ;;
    *) install_hint ;;
  esac
fi
[ -x "$node_bin" ] || install_hint

# Follow links to the real file with the chosen Node.js, so that no command
# other than Node.js and shell builtins runs. Parameter expansion replaces
# dirname. A launcher that is not a link needs no extra process.
self=$0
if [ -L "$self" ]; then
  self=$("$node_bin" -e 'process.stdout.write(process.getBuiltinModule("node:fs").realpathSync(process.argv[1]))' "$0") || {
    echo "LGcode could not find its folder: $0 is not a usable link." >&2
    exit 1
  }
fi
case $self in
  */*) launcher_directory=${self%/*} ;;
  *) launcher_directory=. ;;
esac
[ -n "$launcher_directory" ] || launcher_directory=/
root=$(CDPATH= cd -- "$launcher_directory/.." && pwd -P)
entry=$root/packages/cli/src/bin.ts
if [ ! -f "$entry" ]; then
  entry=$root/bin/stub-entry.ts
fi
exec "$node_bin" "$entry" "$@"
